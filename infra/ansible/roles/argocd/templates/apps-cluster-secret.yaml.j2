apiVersion: v1
kind: Secret
metadata:
  name: apps-cluster
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: cluster   # ← "this is a cluster" for ArgoCD
type: Opaque
stringData:
  name: apps
  server: https://{{ apps_private_ip }}:6443
  config: |
    {
      "tlsClientConfig": {
        "caData": "{{ apps_kcfg.clusters[0].cluster['certificate-authority-data'] }}",
        "certData": "{{ apps_kcfg.users[0].user['client-certificate-data'] }}",
        "keyData": "{{ apps_kcfg.users[0].user['client-key-data'] }}"
      }
    }