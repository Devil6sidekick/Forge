apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url }}
    targetRevision: {{ gitops_revision }}
    path: gitops/argocd                       # the folder of the child Applications
  destination:
    server: https://kubernetes.default.svc    # the HUB (Applications live where ArgoCD is)
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true